# Mini-Drop 环境变量模板
# 复制为 .env 后根据需要修改，不要提交真实密钥
#
# 默认配置面向 Linux Docker 全栈 demo，可直接 docker compose up + make demo。
# 无 Docker 的本机开发请使用 deploy/env/local-native.env.example。
# 生产/公网演示前请开启认证并设置随机密钥：
#   MINI_DROP_API_AUTH_ENABLED=1
#   MINI_DROP_GRPC_AUTH_ENABLED=1
#   MINI_DROP_API_KEY=<your-random-key>
#   MINI_DROP_GRPC_TOKEN=<your-random-token>

MINI_DROP_ENV=dev

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8191
MINI_DROP_API_AUTH_ENABLED=0
MINI_DROP_API_KEY=
# 实验环境可开启：浏览器首次访问自动获得不透明 HttpOnly 会话，不下发 API Key。
MINI_DROP_WEB_AUTO_SESSION_ENABLED=0
# 可选独立签名密钥；留空时随 MINI_DROP_API_KEY 轮换并使旧会话失效。
MINI_DROP_WEB_SESSION_SECRET=
# 留空时按请求协议自动判断；TLS 终止在不传 X-Forwarded-Proto 的代理时设为 1。
MINI_DROP_AUTH_COOKIE_SECURE=
MINI_DROP_ARTIFACT_ROOT=/tmp/mini-drop
MINI_DROP_GRPC_AUTH_ENABLED=0
MINI_DROP_GRPC_TOKEN=
MINI_DROP_GRPC_SECURE=0
MINI_DROP_GRPC_CERT_FILE=
MINI_DROP_GRPC_KEY_FILE=
# 默认不通过 gRPC 下发 MinIO 凭据；开启时服务端还会强制要求 TLS。
MINI_DROP_GRPC_DISTRIBUTE_MINIO_CREDENTIALS=0

# OpenTelemetry Trace（默认关闭；console 用于联调，生产建议使用 otlp）
MINI_DROP_TRACING_ENABLED=0
MINI_DROP_TRACE_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=1

# PostgreSQL
DATABASE_URL=postgresql+psycopg://mini_drop:mini_drop@postgres:5432/mini_drop

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=mini_drop
MINIO_SECRET_KEY=mini_drop_secret
MINIO_BUCKET=mini-drop
MINIO_AUTO_CREATE_BUCKET=1
# 完整部署设为 1；纯本地文件存储模式设为 0。
MINI_DROP_REQUIRE_STORAGE=1
MINIO_SECURE=0

# AI Provider (可选，兼容 OpenAI / DeepSeek / 任意 OpenAI-compatible 服务)
MINI_DROP_AI_ENABLED=full
MINI_DROP_AI_PROVIDER=deepseek
MINI_DROP_AI_BASE_URL=https://api.deepseek.com
MINI_DROP_AI_API_KEY=
MINI_DROP_AI_MODEL=deepseek-v4-flash
MINI_DROP_NLP_ENABLED=true
MINI_DROP_RCA_ENABLED=true
MINI_DROP_SUMMARIZE_ENABLED=true

# 发送给模型的结构化上下文预算；原始 Evidence/Artifact 不受这些限制影响。
MINI_DROP_AI_CONTEXT_MAX_CHARS=24000
MINI_DROP_AI_CONTEXT_MAX_ITEMS=20
MINI_DROP_AI_CONTEXT_MAX_STRING_CHARS=800

# 当前 API Key 对应的可信主体与角色。生产接入 OIDC/网关身份后由可信身份层注入。
MINI_DROP_API_PRINCIPAL_ID=mini-drop-operator
MINI_DROP_API_TENANT_ID=local-development
MINI_DROP_API_ROLES=operator,authorization_admin
# 生产必须设置为至少 32 字节的随机值；用于签发内部短期 Capability Token。
MINI_DROP_CAPABILITY_TOKEN_SECRET=
# 生产默认关闭受控信息源调用，完成身份、Grant 和审计配置后显式开启。
MINI_DROP_AI_SOURCE_ACCESS_ENABLED=0

# Model Context Protocol（MCP 2026-07-28）
# MCP Server 独立进程启动：pip install -e '.[mcp]' && make mcp
MINI_DROP_MCP_ENABLED=0
MINI_DROP_MCP_TRANSPORT=stdio
MINI_DROP_MCP_HOST=127.0.0.1
MINI_DROP_MCP_PORT=8192
# 非本地 stdio 部署必须保持认证开启，并设置独立随机 Token。
MINI_DROP_MCP_AUTH_ENABLED=1
MINI_DROP_MCP_TOKEN=
MINI_DROP_MCP_PRINCIPAL_ID=mini-drop-mcp
MINI_DROP_MCP_ISSUER_URL=http://localhost:8192
MINI_DROP_MCP_RESOURCE_URL=http://localhost:8192/mcp
# 外部 Streamable HTTP MCP 数据源。token_env 只能填环境变量名，禁止内嵌凭据。
# 示例：[{"source_id":"ops-observability","name":"Ops MCP","url":"https://mcp.example.com/mcp","operations":{"metrics.query":"query_metrics"},"resource_dimensions":["cluster_id","service_id"],"data_classes":["operational_metric"],"token_env":"OPS_MCP_TOKEN"}]
MINI_DROP_MCP_CONNECTORS_JSON=[]

# AI 集群诊断资源范围（逗号分隔；留空表示不额外限制，生产建议显式配置）
MINI_DROP_ALLOWED_SERVICES=
# 全局反馈先验可能跨服务污染；默认关闭，完成 tenant/service/version 分桶前勿在生产开启。
MINI_DROP_CASE_FEEDBACK_PRIORS_ENABLED=0

# DeepSeek legacy aliases（仍兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 知识检索默认使用纯词法模式，不下载本地模型，也不需要额外 Key。
# 仅在明确需要向量检索时改为 local 或 openai_compatible 并补齐对应配置。
MINI_DROP_EMBEDDING_PROVIDER=lexical
MINI_DROP_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MINI_DROP_EMBEDDING_BASE_URL=
MINI_DROP_EMBEDDING_API_KEY=
MINI_DROP_EMBEDDING_MODEL=text-embedding-3-small

# Agent
AGENT_ID=agent_local_demo
AGENT_GRPC_ADDR=server:50051
AGENT_HEARTBEAT_INTERVAL_SEC=5
# 完整 Compose 中 Agent 与 Analyzer 不共享本地目录，必须上传到 MinIO。
AGENT_UPLOAD_ARTIFACTS=1
AGENT_GRPC_SECURE=0
AGENT_GRPC_CA_CERT=
AGENT_GRPC_TLS_SERVER_NAME=
# gRPC 监听端口；端口被宿主机占用或保留时可覆盖。
MINI_DROP_GRPC_PORT=50051
# 留空或 0.0.0.0 保持既有的全网卡监听；本机联调可设为 127.0.0.1。
MINI_DROP_GRPC_HOST=0.0.0.0
# Agent 结果会先原子写入此目录，Server 暂时不可用时可在进程重启后补报。
AGENT_RESULT_SPOOL_DIR=/tmp/mini-drop-agent-results
# PENDING/RUNNING/UPLOADING/ANALYZING 超过此时间仍无进展时由 Server 标记失败。
TASK_STALE_TIMEOUT_SEC=900

# ── AI Agent Runtime（E0 起）────────────────────────────────────
# investigator 后端：deterministic | pi_shadow | pi
MINI_DROP_AGENT_RUNTIME=deterministic
# Pi Sidecar 内部协议地址（E3 起生效；pi/pi_shadow 模式必须设置）
MINI_DROP_PI_RUNTIME_URL=
MINI_DROP_PI_RUNTIME_VERSION=0.84.2
# Sidecar 自身监听地址；留空保持 Node 既有的全网卡监听，本机部署建议设为 127.0.0.1。
MINI_DROP_PI_SIDECAR_HOST=
# READ_LOW 步骤是否自动执行（0=先展示等待确认，1=自动连续采集）
MINI_DROP_AGENT_AUTO_READ_LOW=0
# 是否允许 Agent 通过 SourceGateway 调用外部 MCP 补证
MINI_DROP_AGENT_MCP_ENABLED=0
# 活跃 Case 上限与单轮 Skill 数
MINI_DROP_AGENT_MAX_ACTIVE_CASES=4
MINI_DROP_AGENT_SKILLS_ENABLED=0
MINI_DROP_AGENT_SKILL_MAX_PER_TURN=3
# 集群扇出（E3.5 起生效）
MINI_DROP_AGENT_CLUSTER_FANOUT_ENABLED=0
MINI_DROP_AGENT_MAX_FANOUT_TARGETS=8
