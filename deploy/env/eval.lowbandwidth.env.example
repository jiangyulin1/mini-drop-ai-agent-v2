# Mini-Drop low-bandwidth evaluation profile (template only).
#
# This file deliberately contains no credentials. Copy it to a file outside
# the repository, fill the blank values through your secret manager, and pass
# that file to Compose or to the systemd EnvironmentFile entries.
#
# The profile is for the GitHub PR attribution packs: import each pack once,
# then run one smoke round against the same Evidence IDs. Do not upload the
# pack JSON again if a later stability run is requested. Keep the values below
# unchanged when comparing repeated runs.
#
# Compose example (control):
#   docker compose --env-file deploy/env/eval.lowbandwidth.env \
#     -f deploy/compose/jyl-secure.control.yml \
#     -f deploy/compose/eval.lowbandwidth.control.yml up -d server pi-sidecar web
# Compose example (worker, only when real collector Evidence is required):
#   docker compose --env-file deploy/env/eval.lowbandwidth.env \
#     -f deploy/compose/jyl-secure.worker.yml \
#     -f deploy/compose/eval.lowbandwidth.worker.yml up -d
# Live runner example (the explicit flag is required; the runner currently
# defaults to one smoke round):
#   python scripts/run_github_pr_live_eval.py --input-dir <prep-dir>
# Later stability run (explicit, costs three model turns per PR):
#   python scripts/run_github_pr_live_eval.py --input-dir <prep-dir> --rounds 3
#
# Pack-only evaluation does not need a Worker or Analyzer. Leave those
# services stopped unless the case explicitly requires collector Evidence.

MINI_DROP_EVAL_PROFILE=lowbandwidth
MINI_DROP_CONTROL_URL=http://127.0.0.1:8191

# Compose topology (non-secret defaults plus blank secret slots).
CONTROL_BIND_ADDRESS=0.0.0.0
CONTROL_HTTP_PORT=80
CONTROL_HTTPS_PORT=443
CONTROL_GRPC_PORT=51051
CONTROL_MINIO_TLS_PORT=9100
CONTROL_PUBLIC_ADDRESS=
POSTGRES_DB=mini_drop
POSTGRES_USER=mini_drop
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Evaluation request contract (read by the evaluation driver, not by the
# server as global defaults). The current API does not read the four
# MINI_DROP_EVAL_* request variables automatically; the runner must translate
# them into the JSON body shown below.
# ---------------------------------------------------------------------------
# Use this JSON in every agent-turn request for the read-only smoke round:
#   {"runtime_policy":{"side_effect_policy":"READ_ONLY","execution_mode":"dry_run"},"execute_safe_tools":false}
# Use this JSON in a separate proposal block when proposal
# generation is the subject of the test:
#   {"runtime_policy":{"side_effect_policy":"PROPOSE_ONLY","execution_mode":"dry_run"},"execute_safe_tools":false}
# Do not mix READ_ONLY and PROPOSE_ONLY in one stability block. The current
# API takes this policy per request; there is no supported server-wide env var
# that silently overrides it.
MINI_DROP_EVAL_SIDE_EFFECT_POLICY=READ_ONLY
MINI_DROP_EVAL_EXECUTION_MODE=dry_run
MINI_DROP_EVAL_ROUNDS=1
MINI_DROP_EVAL_SERIAL=1

# One-time canonical Evidence import for the public packs. The route accepts
# bounded projections only; any later rounds send the durable Evidence IDs
# instead of the pack bodies. Keep this short-lived token out of
# the repository and out of the normal API key header. The live runner accepts
# `--rounds 3` explicitly for a later stability run.
MINI_DROP_EVAL_IMPORT_ENABLED=1
MINI_DROP_EVAL_IMPORT_TOKEN=

# ---------------------------------------------------------------------------
# Control Server
# ---------------------------------------------------------------------------
MINI_DROP_ENV=eval
SERVER_HOST=0.0.0.0
SERVER_PORT=8191
# Native/systemd runner endpoint. The Compose overlay publishes the same
# container port on loopback so the host-side live runner can reuse this URL.
# Change it if another local process already owns 8191.
MINI_DROP_SERVER_HOST_PORT=8191

# Keep authentication enabled on any reachable host. Inject the values below
# out-of-band; an empty value is intentional in this repository template.
MINI_DROP_API_AUTH_ENABLED=1
MINI_DROP_API_KEY=
MINI_DROP_GRPC_AUTH_ENABLED=1
MINI_DROP_GRPC_TOKEN=
MINI_DROP_AUTH_COOKIE_SECURE=1

# Core dependencies. The exact DATABASE_URL and MinIO credentials belong in
# the deployment secret store, not in this file.
DATABASE_URL=
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mini-drop
MINIO_AUTO_CREATE_BUCKET=1
MINI_DROP_REQUIRE_STORAGE=1

# PR-pack evaluation can run without the asynchronous analyzer. Set this to
# 1 only when the selected cases need a real analyzer worker and its health
# gate; the control override below passes the same value to the server.
MINI_DROP_REQUIRE_ANALYZER=0
MINI_DROP_ANALYZER_OFFLINE_TIMEOUT_SEC=30

# The Pi sidecar supplies the conversational RCA model. The server-side AI
# flags are kept RCA-only to avoid duplicate NLP/summary requests.
MINI_DROP_AI_ENABLED=rca-only
MINI_DROP_AI_PROVIDER=deepseek
# This endpoint is consumed by the server AI client. The Pi sidecar currently
# uses its provider-native endpoint; use a local provider/tunnel there only
# after configuring the sidecar's supported provider adapter.
MINI_DROP_AI_BASE_URL=https://api.deepseek.com
MINI_DROP_AI_API_KEY=
MINI_DROP_AI_MODEL=deepseek-v4-flash
MINI_DROP_NLP_ENABLED=0
MINI_DROP_RCA_ENABLED=1
MINI_DROP_SUMMARIZE_ENABLED=0

# Bound the serialized CaseContext sent to the model. These are deliberately
# conservative; raise them only if a documented case loses required evidence.
MINI_DROP_AI_CONTEXT_MAX_CHARS=8000
MINI_DROP_AI_CONTEXT_MAX_ITEMS=5
MINI_DROP_AI_CONTEXT_MAX_STRING_CHARS=300

# No external source fan-out or telemetry during the bandwidth test.
MINI_DROP_MCP_ENABLED=0
MINI_DROP_AGENT_MCP_ENABLED=0
MINI_DROP_AI_SOURCE_ACCESS_ENABLED=0
MINI_DROP_TRACING_ENABLED=0

# ---------------------------------------------------------------------------
# Agent runtime / Pi sidecar
# ---------------------------------------------------------------------------
MINI_DROP_AGENT_RUNTIME=pi
# This loopback URL is for the native/systemd layout. The Compose overlay
# replaces it with http://pi-sidecar:8899 because containers cannot use this
# loopback address to reach a sibling service.
MINI_DROP_PI_RUNTIME_URL=http://127.0.0.1:8899
MINI_DROP_PI_RUNTIME_VERSION=0.84.2
MINI_DROP_PI_INTERNAL_TOKEN=
MINI_DROP_PI_SIDECAR_PORT=8899
# Host-only mapping used by the live runner's health probe. Keep it bound to
# loopback; the sidecar still requires its internal token.
MINI_DROP_PI_SIDECAR_HOST_PORT=8899
# Native/systemd sidecar target. The Compose overlay replaces this with
# http://server:8191 for the container network.
MINI_DROP_PI_INTERNAL_BASE=http://127.0.0.1:8191
MINI_DROP_PI_MODEL_PROVIDER=deepseek
MINI_DROP_PI_MODEL=deepseek-v4-flash

# Optional local catalog/auth files. Paths are injected by deployment, never
# copied into this repository. If a models.json is used in Compose, mount it
# read-only at the same container path and set MINI_DROP_PI_MODELS_PATH there.
MINI_DROP_PI_MODELS_PATH=
MINI_DROP_PI_AUTH_PATH=
MINI_DROP_PI_CONTEXT_MAX_CHARS=8000
# Keep each stability round independent and prevent the Pi SDK conversation
# history from growing across rounds. Durable Case/Evidence history remains in
# Control, so this does not re-upload projections or lose citations.
MINI_DROP_PI_RESET_SESSION_PER_TURN=1

# Low keeps provider responses smaller. Keep it fixed for any repeated run;
# changing it would make comparisons less meaningful.
MINI_DROP_PI_THINKING_LEVEL=low

# Provider credentials normally stay inside the Pi sidecar.  The live runner
# does not require a locally visible AI key; set this only when the evaluation
# host must enforce a local credential/catalog preflight.
MINI_DROP_EVAL_REQUIRE_PROVIDER_KEY=0
# The one-round smoke has no cross-round history. If --rounds 3 is used later,
# this cap applies to each current projection; the reset flag above prevents
# the Pi session history from accumulating between rounds.

# Pi SDK startup may otherwise refresh model catalogs/update metadata. This
# disables those startup network calls (the runtime also sets its catalog
# network allowance to false); it does not disable the real completion request
# to the configured provider.
PI_OFFLINE=1

# These aliases are accepted by the sidecar. Set exactly one key out-of-band.
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Agent safety and concurrency gates
# ---------------------------------------------------------------------------
# No automatic collection, MCP, fan-out or skills. One active Case keeps the
# upload pattern serial and makes each round attributable to one case.
MINI_DROP_AGENT_AUTO_READ_LOW=0
MINI_DROP_AGENT_CLUSTER_FANOUT_ENABLED=1
MINI_DROP_AGENT_MAX_FANOUT_TARGETS=1
MINI_DROP_AGENT_MAX_ACTIVE_CASES=1
MINI_DROP_AGENT_SKILLS_ENABLED=0
MINI_DROP_AGENT_SKILL_MAX_PER_TURN=0

# ---------------------------------------------------------------------------
# Worker (only for cases that need real collector Evidence)
# ---------------------------------------------------------------------------
AGENT_ID=
AGENT_IP_ADDR=
AGENT_GRPC_ADDR=
AGENT_GRPC_SECURE=1
AGENT_GRPC_CA_CERT=
AGENT_GRPC_TLS_SERVER_NAME=
AGENT_HEARTBEAT_INTERVAL_SEC=15

# PR packs already contain the bounded public input. Do not send raw collector
# artifacts to MinIO during this evaluation. Flip to 1 only for a case whose
# score explicitly depends on newly collected runtime artifacts.
AGENT_UPLOAD_ARTIFACTS=0
AGENT_RESULT_SPOOL_DIR=/tmp/mini-drop-agent-results
MINIO_SECURE=1

# ---------------------------------------------------------------------------
# Analyzer
# ---------------------------------------------------------------------------
# Generated flamegraphs/top output are not needed for the public PR packs.
# Disabling publication avoids the largest server-bound upload. The analyzer
# may still run locally if MINI_DROP_REQUIRE_ANALYZER=1.
MINI_DROP_ANALYZER_UPLOAD=0

# ---------------------------------------------------------------------------
# Runner-side transfer discipline (documented, not server env defaults)
# ---------------------------------------------------------------------------
# 1. Fetch/import each of the eight packs once and retain its Evidence IDs.
# 2. For a later repeated run, send IDs, projection hashes and selected spans;
#    do not resend diff/comment/runtime JSON.
# 3. Run cases serially (one active case), and keep the same policy, model,
#    context budgets and thinking level across runs.
# 4. For an offline cache check use the runner's --offline flag. It prevents
#    GitHub/control probes, while the above service flags prevent extra source
#    and artifact traffic during a live run.
