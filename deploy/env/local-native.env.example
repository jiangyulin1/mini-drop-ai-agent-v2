# Mini-Drop native development profile.
#
# Copy this file to the repository root as `.env` for a local, non-Docker
# development run. `.env` is ignored by Git. Keep provider credentials in a
# separate mode-0600 file and inject them only when starting the Pi Sidecar.

MINI_DROP_ENV=local
SERVER_HOST=127.0.0.1
SERVER_PORT=8191

# Local control plane: SQLite and a shared filesystem replace PostgreSQL and
# MinIO. Analyzer is still required because it closes the durable Task flow.
DATABASE_URL=
SQLITE_PATH=mini_drop.db
MINI_DROP_ARTIFACT_ROOT=/tmp/mini-drop
MINIO_AUTO_CREATE_BUCKET=0
MINI_DROP_REQUIRE_STORAGE=0
MINI_DROP_REQUIRE_ANALYZER=1
MINI_DROP_ANALYZER_UPLOAD=0

# Loopback-only demo access. Do not use these settings on a reachable host.
MINI_DROP_API_AUTH_ENABLED=0
MINI_DROP_API_KEY=
MINI_DROP_AUTH_COOKIE_SECURE=0
MINI_DROP_API_PRINCIPAL_ID=mini-drop-local-operator
MINI_DROP_API_TENANT_ID=local-development
MINI_DROP_API_ROLES=operator,authorization_admin

# Local Agent and gRPC channel.
MINI_DROP_GRPC_HOST=127.0.0.1
MINI_DROP_GRPC_PORT=50051
MINI_DROP_GRPC_AUTH_ENABLED=0
MINI_DROP_GRPC_TOKEN=
MINI_DROP_GRPC_SECURE=0
AGENT_ID=agent_local_demo
AGENT_GRPC_ADDR=127.0.0.1:50051
AGENT_HEARTBEAT_INTERVAL_SEC=5
AGENT_UPLOAD_ARTIFACTS=0
AGENT_RESULT_SPOOL_DIR=/tmp/mini-drop-agent-results

# Server-side NLP/summary provider features. `none` is the valid disabled
# value; `off` and `on` are not part of the supported enum.
MINI_DROP_AI_ENABLED=none
MINI_DROP_AI_PROVIDER=deepseek
MINI_DROP_AI_BASE_URL=https://api.deepseek.com
MINI_DROP_AI_API_KEY=
MINI_DROP_AI_MODEL=deepseek-v4-flash
MINI_DROP_NLP_ENABLED=0
MINI_DROP_RCA_ENABLED=0
MINI_DROP_SUMMARIZE_ENABLED=0
MINI_DROP_AI_SOURCE_ACCESS_ENABLED=0

# Evidence Agent Runtime. Start with deterministic mode. See
# docs/environment-setup.md before switching this to `pi`.
MINI_DROP_AGENT_RUNTIME=deterministic
MINI_DROP_PI_RUNTIME_URL=http://127.0.0.1:8899
MINI_DROP_PI_RUNTIME_VERSION=0.84.2
MINI_DROP_PI_INTERNAL_TOKEN=
MINI_DROP_PI_SIDECAR_HOST=127.0.0.1
MINI_DROP_PI_SIDECAR_PORT=8899
MINI_DROP_PI_INTERNAL_BASE=http://127.0.0.1:8191
MINI_DROP_PI_MODEL_PROVIDER=deepseek
MINI_DROP_PI_MODEL=deepseek-v4-flash
MINI_DROP_PI_THINKING_LEVEL=low
MINI_DROP_PI_CONTEXT_MAX_CHARS=8000
MINI_DROP_PI_RESET_SESSION_PER_TURN=1
PI_OFFLINE=1

# Lexical retrieval is download-free. A local embedding model is opt-in.
MINI_DROP_EMBEDDING_PROVIDER=lexical

# Optional network integrations stay closed in the native profile.
MINI_DROP_MCP_ENABLED=0
MINI_DROP_AGENT_MCP_ENABLED=0
MINI_DROP_AGENT_CLUSTER_FANOUT_ENABLED=0
MINI_DROP_TRACING_ENABLED=0
