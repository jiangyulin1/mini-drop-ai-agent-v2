[Unit]
Description=Mini-Drop Asynchronous Analyzer Worker
After=network-online.target mini-drop-s3.service mini-drop-server.service
Wants=network-online.target
Requires=mini-drop-s3.service

[Service]
Type=simple
User=control
Group=control
WorkingDirectory=/home/control/mini-drop-active
EnvironmentFile=/home/control/mini-drop-active/deploy/env/control-native.env
Environment=MINI_DROP_GRPC_SECURE=0
ExecStart=/home/control/mini-drop-active/.venv/bin/python -m analyzer.mini_drop_analyzer.worker
Restart=always
RestartSec=5
TimeoutStopSec=150
KillMode=mixed
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
