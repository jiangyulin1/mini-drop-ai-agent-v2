{
  "case_id": "ob-conn-exhaust-001",
  "user_query": "连接压力 fixture 出现请求失败和 fd 持续增长，请判断根因域与故障进程。",
  "system": {
    "name": "online-boutique",
    "version": "trimmed-core",
    "topology": ["frontend", "productcatalogservice", "connection-pressure-fixture"],
    "agents": ["worker1", "worker2"]
  },
  "fault": {
    "type": "connection",
    "target_service": "connection-pressure-fixture",
    "target_node": "worker1",
    "duration_sec": 180,
    "intensity": 0.9,
    "reversible": true
  },
  "trigger": {
    "workload_script": "scripts/load-gen.sh",
    "load_profile": "constant-80qps + 连接压力",
    "description": "启动版本化连接压力 fixture，持续持有 socket 与 fd，制造可归因到该进程的连接耗尽"
  },
  "execution": {
    "preflight_script": "scripts/preflight.sh",
    "runner_script": "faults/run-fault.sh",
    "requires_linux": true,
    "required_env": ["TARGET_URL"]
  },
  "performance_requirements": {
    "baseline_duration_sec": 60,
    "recovery_timeout_sec": 120,
    "max_diagnosis_sec": 300,
    "repetitions": 3
  },
  "capture": {
    "collectors": ["sys_metrics", "process_scan"],
    "window": "before=60s, during=180s, after=60s"
  },
  "expected": {
    "root_location": "self",
    "domain_cause": "network",
    "root_entity": "connection-pressure-fixture",
    "evidence_domains": ["process", "network"]
  },
  "oracle_visibility": "private",
  "ground_truth_source": "self-injected",
  "status": "designed",
  "notes": "独立 fixture 避免把客户端持有的 fd 错归因给 frontend；VM 运行时以注入脚本记录的 PID 为目标。"
}
