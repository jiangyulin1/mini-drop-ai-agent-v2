  {
    "scenario_id": "otel_payment_unreachable",
    "query": "结算失败，支付服务当前不可达，请判断故障位置。",
    "scope": {
      "target_service": "checkoutservice",
      "same_host_instance_ids": [],
      "downstream_service_ids": ["paymentservice"],
      "instances": [
        {"service_id": "checkoutservice", "instance_id": "checkout-1", "host_id": "worker2", "agent_id": "a2", "pid": 2101},
        {"service_id": "paymentservice", "instance_id": "payment-1", "host_id": "worker2", "agent_id": "a2", "pid": 2201}
      ]
    },
    "observations": [
      {
        "task_id": "payment-probe", "collector_type": "connection_probe", "source_family": "active_probe", "evidence_weight": 0.95,
        "target": {"service_id": "checkoutservice", "instance_id": "checkout-1", "host_id": "worker2", "agent_id": "a2", "pid": 2101},
        "facts": {"endpoint.reachable": false, "endpoint.unreachable_count": 3, "endpoint.downstream_service": "paymentservice", "endpoint.container_state": "paused"},
        "top_function": {"name": "", "percent": 0}, "pressure": {}, "evidence_refs": ["ev-payment-probe"]
      }
    ],
    "expected": {
      "classification": "downstream_dependency", "root_location": "downstream", "domain_cause": "network",
      "finding_types": ["endpoint_unreachable", "downstream_dependency"], "knowledge_refs": ["distributed.downstream_pressure"],
      "action_collectors": ["sys_metrics"]
    }
  },
